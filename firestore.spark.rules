rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
  function active() { return signed() && (!exists(userDoc()) || get(userDoc()).data.blocked != true); }
  function verified() { return active() && request.auth.token.email_verified == true; }
  function admin() { return active() && (request.auth.token.get('admin',false) == true || (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'admin')); }
  function str(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function phone(v) { return v is string && v.matches('\\+992[0-9]{9}'); }
  function id(v) { return v is string && v.matches('[a-zA-Z0-9_-]{1,128}'); }
  function fresh(d) { return d.createdAt == request.time && d.updatedAt == request.time && d.version == 1; }
  function edited() { return request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time && request.resource.data.version == resource.data.version + 1; }
  function audited(path) {
   let d=request.resource.data;
   let log=getAfter(/databases/$(database)/documents/auditLogs/$(d.lastEventId)).data;
   return id(d.lastEventId) && log.actorId==request.auth.uid && log.targetPath==path && log.version==d.version && log.createdAt==request.time && (resource==null ? fresh(d) : edited());
  }
  function point(p) { return p is map && p.keys().hasOnly(['lat','lon','name']) && p.lat is number && p.lon is number && p.lat>=35.5 && p.lat<=42 && p.lon>=66 && p.lon<=76.5 && str(p.name,160); }
  function orderAfter(oid) { return getAfter(/databases/$(database)/documents/serviceOrders/$(oid)).data; }
  function participant(o) { return signed() && (o.customerId==request.auth.uid || o.providerId==request.auth.uid); }
  function provider(type,uid) { return type=='master' ? get(/databases/$(database)/documents/technicianProfiles/$(uid)).data : get(/databases/$(database)/documents/driverProfiles/$(uid)).data; }
  function providerContact(type,uid) { let aid=uid+'_technician';return type=='master' ? get(/databases/$(database)/documents/providerApplications/$(aid)).data.phone : provider(type,uid).phone; }
  function providerReady(o) { let p=provider(o.serviceType,request.auth.uid);return verified() && p.status=='approved' && p.cityId==o.cityId && (o.serviceType=='delivery' || p.category==o.category); }
  function orderEvent(oid) { let d=request.resource.data; let e=getAfter(/databases/$(database)/documents/serviceOrders/$(oid)/events/$(d.lastEventId)).data;return e.actorId==request.auth.uid && e.version==d.version && e.createdAt==request.time; }
  function ended(s) { return s in ['completed','cancelled']; }
  function released(o,oid) {
   return getAfter(/databases/$(database)/documents/activeCustomers/$(o.customerId)).data.orderId==null && (o.providerId==null || getAfter(/databases/$(database)/documents/activeProviders/$(o.providerId)).data.orderId==null) && getAfter(/databases/$(database)/documents/orderOffers/$(oid)).data.status==o.status;
  }
  match /adminRoles/{uid} { allow get: if signed() && (uid==request.auth.uid || admin());allow list: if admin();allow write: if false; }
  match /users/{uid} {
   allow get: if signed() && (uid==request.auth.uid || admin());allow list: if admin();
   allow create: if active() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['name','email','city','blocked','blockedReason','version','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size()<=80 && request.resource.data.email==request.auth.token.email && request.resource.data.city=='dushanbe' && request.resource.data.blocked==false && request.resource.data.blockedReason=='' && fresh(request.resource.data);
   allow update: if (active() && uid==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','city','updatedAt']) && request.resource.data.updatedAt==request.time && request.resource.data.name is string && request.resource.data.name.size()<=80) || (admin() && uid!=request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked','blockedReason','version','lastEventId','updatedAt']) && request.resource.data.blocked is bool && str(request.resource.data.blockedReason,500) && audited('users/'+uid));
  }
  match /jobPosts/{jid} {
   allow read: if resource.data.status=='published' || (signed() && resource.data.ownerId==request.auth.uid) || admin();
   allow create: if verified() && request.resource.data.keys().hasOnly(['ownerId','title','company','description','city','category','status','createdAt','updatedAt','version']) && request.resource.data.ownerId==request.auth.uid && request.resource.data.status=='pending_review' && str(request.resource.data.title,120) && str(request.resource.data.company,120) && str(request.resource.data.description,4000) && request.resource.data.city=='Dushanbe' && fresh(request.resource.data);
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderationReason','version','lastEventId','updatedAt']) && request.resource.data.status in ['published','rejected','closed'] && str(request.resource.data.moderationReason,500) && audited('jobPosts/'+jid);
  }
  match /jobApplications/{aid} {
   allow get: if signed() && (resource==null || resource.data.candidateId==request.auth.uid || resource.data.employerId==request.auth.uid || admin());allow list: if admin() || (signed() && request.query.limit<=100 && (resource.data.candidateId==request.auth.uid || resource.data.employerId==request.auth.uid));
   allow create: if verified() && request.resource.data.keys().hasOnly(['jobId','candidateId','employerId','status','createdAt','updatedAt','version']) && id(request.resource.data.jobId) && aid==request.resource.data.jobId+'_'+request.auth.uid && request.resource.data.candidateId==request.auth.uid && request.resource.data.employerId==get(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.ownerId && request.resource.data.employerId!=request.auth.uid && get(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.status=='published' && request.resource.data.status=='submitted' && fresh(request.resource.data);
  }
  match /providerApplications/{aid} {
   allow get: if signed() && (resource==null || resource.data.ownerId==request.auth.uid || admin());allow list: if admin();
   allow create,update: if (verified() && request.resource.data.ownerId==request.auth.uid && aid==request.auth.uid+'_'+request.resource.data.role && request.resource.data.role in ['driver','technician'] && request.resource.data.status=='pending' && request.resource.data.keys().hasOnly(['ownerId','role','name','phone','vehicle','plate','skills','category','city','status','reason','version','createdAt','updatedAt']) && str(request.resource.data.name,80) && phone(request.resource.data.phone) && request.resource.data.reason=='' && str(request.resource.data.category,40) && request.resource.data.city=='Dushanbe' && request.resource.data.vehicle is string && request.resource.data.vehicle.size()<=80 && request.resource.data.plate is string && request.resource.data.plate.size()<=20 && request.resource.data.skills is string && request.resource.data.skills.size()<=120 && (resource==null ? fresh(request.resource.data) : resource.data.status=='rejected' && edited())) || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason','version','lastEventId','updatedAt']) && request.resource.data.status in ['approved','rejected','suspended'] && str(request.resource.data.reason,500) && audited('providerApplications/'+aid));
  }
  match /driverProfiles/{uid} {
   allow get: if signed() && (uid==request.auth.uid || admin());allow list: if admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['ownerId','name','city','cityId','category','status','vehicle','phone','version','lastEventId','createdAt','updatedAt']) && request.resource.data.ownerId==uid && str(request.resource.data.name,80) && phone(request.resource.data.phone) && str(request.resource.data.vehicle,80) && request.resource.data.status in ['approved','rejected','suspended'] && audited('driverProfiles/'+uid);
  }
  match /technicianProfiles/{uid} {
   allow read: if resource.data.status=='approved' || (signed() && uid==request.auth.uid) || admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['ownerId','name','city','cityId','category','status','skills','description','version','lastEventId','createdAt','updatedAt']) && request.resource.data.ownerId==uid && str(request.resource.data.name,80) && str(request.resource.data.skills,120) && request.resource.data.status in ['approved','rejected','suspended'] && audited('technicianProfiles/'+uid);
  }
  match /settings/{sid} {
   allow read: if sid=='platform';
   allow create,update: if admin() && sid=='platform' && request.resource.data.keys().hasOnly(['ordersEnabled','services','supportEmail','supportPhone','notice','cityId','version','lastEventId','createdAt','updatedAt']) && request.resource.data.ordersEnabled is bool && request.resource.data.services.keys().hasOnly(['taxi','master','delivery']) && request.resource.data.services.taxi is bool && request.resource.data.services.master is bool && request.resource.data.services.delivery is bool && request.resource.data.cityId=='dushanbe' && request.resource.data.notice is string && request.resource.data.notice.size()<=1000 && request.resource.data.supportEmail is string && request.resource.data.supportEmail.size()<=160 && request.resource.data.supportPhone is string && request.resource.data.supportPhone.size()<=30 && audited('settings/'+sid);
  }
  match /cities/{cid} {
   allow read: if resource.data.active==true || admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['name','active','timezone','version','lastEventId','createdAt','updatedAt']) && str(request.resource.data.name,80) && request.resource.data.active is bool && str(request.resource.data.timezone,80) && audited('cities/'+cid);
  }
  match /categories/{cid} {
   allow read: if resource.data.active==true || admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['name','serviceType','active','version','lastEventId','createdAt','updatedAt']) && str(request.resource.data.name,80) && request.resource.data.serviceType in ['taxi','master','delivery','jobs'] && request.resource.data.active is bool && audited('categories/'+cid);
  }
  match /tariffs/{tid} {
   allow read: if resource.data.active==true || admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['name','category','cityId','baseMinor','perKmMinor','minimumMinor','active','currency','version','lastEventId','createdAt','updatedAt']) && str(request.resource.data.name,80) && request.resource.data.baseMinor is int && request.resource.data.baseMinor>=0 && request.resource.data.baseMinor<=10000000 && request.resource.data.perKmMinor is int && request.resource.data.perKmMinor>=0 && request.resource.data.perKmMinor<=10000000 && request.resource.data.minimumMinor is int && request.resource.data.minimumMinor>=0 && request.resource.data.minimumMinor<=10000000 && request.resource.data.active is bool && request.resource.data.currency=='TJS' && audited('tariffs/'+tid);
  }
  match /organizations/{oid} {allow read: if admin() || (signed() && resource.data.ownerId==request.auth.uid);allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason','version','lastEventId','updatedAt']) && request.resource.data.status in ['approved','suspended','rejected'] && audited('organizations/'+oid);}
  match /complaints/{cid} {
   allow get: if signed() && (resource==null || resource.data.ownerId==request.auth.uid || admin());allow list: if admin() || (signed() && resource.data.ownerId==request.auth.uid);
   allow create: if signed() && request.auth.token.email_verified==true && request.resource.data.keys().hasOnly(['ownerId','orderId','subject','description','status','resolution','version','createdAt','updatedAt']) && request.resource.data.ownerId==request.auth.uid && id(request.resource.data.orderId) && cid==request.resource.data.orderId+'_'+request.auth.uid && participant(get(/databases/$(database)/documents/serviceOrders/$(request.resource.data.orderId)).data) && str(request.resource.data.subject,80) && str(request.resource.data.description,2000) && request.resource.data.status=='open' && request.resource.data.resolution=='' && fresh(request.resource.data);
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','version','lastEventId','updatedAt']) && request.resource.data.status in ['open','investigating','resolved','dismissed'] && str(request.resource.data.resolution,1000) && audited('complaints/'+cid);
  }
  match /auditLogs/{eid} {
   allow get: if admin();allow list: if admin() && request.query.limit<=100;
   allow create: if admin() && request.resource.data.keys().hasOnly(['actorId','action','targetPath','targetCollection','targetId','reason','version','createdAt']) && request.resource.data.actorId==request.auth.uid && request.resource.data.createdAt==request.time && str(request.resource.data.reason,500) && request.resource.data.targetCollection in ['users','providerApplications','driverProfiles','technicianProfiles','jobPosts','complaints','settings','cities','categories','tariffs','organizations'] && id(request.resource.data.targetId) && request.resource.data.targetPath==request.resource.data.targetCollection+'/'+request.resource.data.targetId && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.lastEventId==eid && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.version==request.resource.data.version;
  }
  match /serviceOrders/{oid} {
   allow get: if admin() || (signed() && (resource==null || participant(resource.data)));
   allow list: if admin() || (signed() && request.query.limit<=100 && (resource.data.customerId==request.auth.uid || resource.data.providerId==request.auth.uid));
   allow create: if verified() && request.resource.data.keys().hasOnly(['customerId','customerName','customerPhone','providerId','providerName','providerPhone','serviceType','category','cityId','pickup','destination','notes','paymentMethod','status','quoteMinor','quoteAccepted','pickupConfirmed','paymentReported','paymentConfirmed','currency','version','lastEventId','createdAt','updatedAt']) && request.resource.data.customerId==request.auth.uid && request.resource.data.providerId==null && request.resource.data.providerName=='' && request.resource.data.providerPhone=='' && str(request.resource.data.customerName,80) && phone(request.resource.data.customerPhone) && request.resource.data.serviceType in ['taxi','master','delivery'] && str(request.resource.data.category,40) && request.resource.data.cityId=='dushanbe' && point(request.resource.data.pickup) && (request.resource.data.serviceType=='master' ? request.resource.data.destination==null : point(request.resource.data.destination)) && request.resource.data.notes is string && request.resource.data.notes.size()<=1000 && request.resource.data.paymentMethod in ['cash','direct_transfer'] && request.resource.data.currency=='TJS' && request.resource.data.status=='requested' && request.resource.data.quoteMinor==null && request.resource.data.quoteAccepted==false && request.resource.data.pickupConfirmed==false && request.resource.data.paymentReported==false && request.resource.data.paymentConfirmed==false && fresh(request.resource.data) && get(/databases/$(database)/documents/settings/platform).data.ordersEnabled==true && get(/databases/$(database)/documents/settings/platform).data.services[request.resource.data.serviceType]==true && get(/databases/$(database)/documents/cities/dushanbe).data.active==true && getAfter(/databases/$(database)/documents/activeCustomers/$(request.auth.uid)).data.orderId==oid && getAfter(/databases/$(database)/documents/orderOffers/$(oid)).data.status=='requested' && orderEvent(oid);
   allow update: if signed() && edited() && orderEvent(oid) && (
    (resource.data.status=='requested' && resource.data.providerId==null && request.resource.data.status=='accepted' && request.resource.data.providerId==request.auth.uid && resource.data.customerId!=request.auth.uid && providerReady(resource.data) && request.resource.data.providerName==provider(resource.data.serviceType,request.auth.uid).name && request.resource.data.providerPhone==providerContact(resource.data.serviceType,request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerId','providerName','providerPhone','status','version','lastEventId','updatedAt']) && getAfter(/databases/$(database)/documents/activeProviders/$(request.auth.uid)).data.orderId==oid && getAfter(/databases/$(database)/documents/orderOffers/$(oid)).data.providerId==request.auth.uid && getAfter(/databases/$(database)/documents/orderOffers/$(oid)).data.status=='accepted') ||
    (resource.data.providerId==request.auth.uid && ((resource.data.status=='accepted' && request.resource.data.status=='arriving') || (resource.data.status=='arriving' && request.resource.data.status=='arrived') || (resource.data.status=='arrived' && request.resource.data.status=='in_progress' && resource.data.quoteAccepted==true && resource.data.pickupConfirmed==true) || (resource.data.status=='in_progress' && request.resource.data.status=='completed' && released(request.resource.data,oid))) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','lastEventId','updatedAt'])) ||
    (participant(resource.data) && request.resource.data.status=='cancelled' && resource.data.status in ['requested','accepted','arriving','arrived'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','lastEventId','updatedAt']) && released(request.resource.data,oid)) ||
    (resource.data.providerId==request.auth.uid && resource.data.status in ['accepted','arriving','arrived'] && resource.data.quoteAccepted==false && request.resource.data.quoteMinor is int && request.resource.data.quoteMinor>0 && request.resource.data.quoteMinor<=10000000 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteMinor','version','lastEventId','updatedAt'])) ||
    (resource.data.customerId==request.auth.uid && resource.data.status in ['accepted','arriving','arrived'] && resource.data.quoteMinor is int && resource.data.quoteMinor>0 && request.resource.data.quoteAccepted==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteAccepted','version','lastEventId','updatedAt'])) ||
    (resource.data.customerId==request.auth.uid && resource.data.status=='arrived' && resource.data.quoteAccepted==true && request.resource.data.pickupConfirmed==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickupConfirmed','version','lastEventId','updatedAt'])) ||
    (resource.data.status=='completed' && ((resource.data.customerId==request.auth.uid && request.resource.data.paymentReported==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentReported','version','lastEventId','updatedAt'])) || (resource.data.providerId==request.auth.uid && resource.data.paymentReported==true && request.resource.data.paymentConfirmed==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentConfirmed','version','lastEventId','updatedAt']))))
   );
   match /events/{eid} {
    allow read: if admin() || participant(get(/databases/$(database)/documents/serviceOrders/$(oid)).data);
    allow create: if signed() && request.resource.data.keys().hasOnly(['actorId','action','version','reason','createdAt']) && request.resource.data.actorId==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.reason is string && request.resource.data.reason.size()<=500 && orderAfter(oid).lastEventId==eid && orderAfter(oid).version==request.resource.data.version && participant(orderAfter(oid));
   }
  }
  match /orderOffers/{oid} {
   allow get: if active() && (resource==null || resource.data.customerId==request.auth.uid || providerReady(resource.data) || admin());
   allow list: if active() && request.query.limit<=30 && (admin() || (resource.data.status=='requested' && providerReady(resource.data)));
   allow create: if verified() && request.resource.data.keys().hasOnly(['orderId','customerId','providerId','serviceType','category','cityId','pickupZone','destinationZone','status','createdAt','updatedAt']) && request.resource.data.orderId==oid && request.resource.data.customerId==request.auth.uid && request.resource.data.providerId==null && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && request.resource.data.status=='requested' && request.resource.data.serviceType==orderAfter(oid).serviceType && request.resource.data.category==orderAfter(oid).category && request.resource.data.cityId==orderAfter(oid).cityId && str(request.resource.data.pickupZone,40) && request.resource.data.destinationZone is string && request.resource.data.destinationZone.size()<=40 && orderAfter(oid).customerId==request.auth.uid;
   allow update: if signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerId','status','updatedAt']) && request.resource.data.updatedAt==request.time && participant(orderAfter(oid)) && request.resource.data.status==orderAfter(oid).status && request.resource.data.providerId==orderAfter(oid).providerId;
  }
  match /activeCustomers/{uid} {
   allow get: if signed() && (uid==request.auth.uid || admin() || (resource!=null && resource.data.orderId!=null && participant(get(/databases/$(database)/documents/serviceOrders/$(resource.data.orderId)).data)));
   allow create,update: if signed() && request.resource.data.keys().hasOnly(['orderId','lastCreatedAt','updatedAt']) && request.resource.data.updatedAt==request.time && ((verified() && uid==request.auth.uid && request.resource.data.orderId is string && (resource==null || resource.data.orderId==null && request.time>=resource.data.lastCreatedAt+duration.value(30,'s')) && request.resource.data.lastCreatedAt==request.time && orderAfter(request.resource.data.orderId).customerId==uid && orderAfter(request.resource.data.orderId).status=='requested') || (resource!=null && resource.data.orderId!=null && request.resource.data.orderId==null && request.resource.data.lastCreatedAt==resource.data.lastCreatedAt && participant(orderAfter(resource.data.orderId)) && ended(orderAfter(resource.data.orderId).status)));
  }
  match /activeProviders/{uid} {
   allow get: if active() && (uid==request.auth.uid || admin());
   allow create,update: if signed() && request.resource.data.keys().hasOnly(['orderId','updatedAt']) && request.resource.data.updatedAt==request.time && ((uid==request.auth.uid && request.resource.data.orderId is string && (resource==null || resource.data.orderId==null) && orderAfter(request.resource.data.orderId).providerId==uid && orderAfter(request.resource.data.orderId).status=='accepted') || (resource!=null && resource.data.orderId!=null && request.resource.data.orderId==null && participant(orderAfter(resource.data.orderId)) && ended(orderAfter(resource.data.orderId).status)));
  }
  match /{document=**} { allow read,write: if false; }
 }
}
